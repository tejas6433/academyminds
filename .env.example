# This is an example of your .env file format, which pnpm db:setup will create.
# Note: this must be .env, not .env.local, without further configuration changes.
POSTGRES_URL=postgresql://***
STRIPE_SECRET_KEY=sk_test_***
STRIPE_WEBHOOK_SECRET=whsec_***
BASE_URL=http://localhost:3000
AUTH_SECRET=***

# Zoom Server-to-Server OAuth (live class recording). Optional in dev — the app
# falls back to placeholder meetings when absent.
ZOOM_ACCOUNT_ID=***
ZOOM_CLIENT_ID=***
ZOOM_CLIENT_SECRET=***
ZOOM_WEBHOOK_SECRET_TOKEN=***

# Cloudflare R2 storage for class recordings (S3-compatible, zero egress fees).
# Optional in dev — recording transfer is skipped when absent.
R2_ACCOUNT_ID=***
R2_ACCESS_KEY_ID=***
R2_SECRET_ACCESS_KEY=***
R2_BUCKET=academyminds-recordings

# Shared secret protecting the /api/cron/* routes (transfer retry + retention).
# Vercel Cron sends this automatically as `Authorization: Bearer $CRON_SECRET`.
CRON_SECRET=***

# Inbox that receives new-enquiry and new-subscription notifications.
# Falls back to support@academyminds.com when unset.
ENQUIRY_NOTIFY_EMAIL=you@example.com

# Google Search Console ownership token (HTML-tag verification method).
# When set, the meta verification tag is rendered site-wide.
GOOGLE_SITE_VERIFICATION=***

# Google Classroom join/invite link for assignments. When set, an "Assignments"
# link appears in the student dashboard nav. Leave unset to hide it.
GOOGLE_CLASSROOM_URL=https://classroom.google.com/c/XXXXXXXXX
